ell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" edge="1" parent="1" source="cfg" target="pair"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="pq" value="Cạnh chưa có port và config sạch&lt;br&gt;của cặp có đúng 1 port?" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="190" width="230" height="50" as="geometry" /></mxCell><mxCell id="pf" value="Lấy port đó: port_source = config,&lt;br&gt;cờ port_from_config" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="330" y="193" width="240" height="44" as="geometry" /></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" edge="1" parent="1" source="pair" target="pq"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" value="có" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" edge="1" parent="1" source="pq" target="pf"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="m" value="&lt;b&gt;Khớp từng config với từng cạnh&lt;/b&gt;&lt;br&gt;theo port" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="280" width="230" height="50" as="geometry" /></mxCell><mxCell id="e5" value="không / xong" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" edge="1" parent="1" source="pq" target="m"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="lv" value="EXACT: cùng port, protocol khớp hoặc không ghi&lt;br&gt;PORT_ONLY: cùng port, lệch protocol&lt;br&gt;PAIR_ONLY: không so được port" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=8;fontSize=10;" vertex="1" parent="1"><mxGeometry x="330" y="275" width="240" height="60" as="geometry" /></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;dashed=1;endArrow=none;" edge="1" parent="1" source="m" target="lv"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="pick" value="Mỗi cạnh chọn &lt;b&gt;1 config&lt;/b&gt;: mức khớp cao nhất&lt;br&gt;→ finding sạch → item_id nhỏ nhất" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="370" width="230" height="50" as="geometry" /></mxCell><mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" edge="1" parent="1" source="m" target="pick"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="lo" value="Config dư (port không có traffic)&lt;br&gt;hoặc cặp chỉ có config&lt;br&gt;→ mỗi port 1 dòng &lt;b&gt;NOT_OBSERVED&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="330" y="365" width="240" height="60" as="geometry" /></mxCell><mxCell id="e8" value="không khớp cạnh nào" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" edge="1" parent="1" source="lv" target="lo"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="lo2" value="config sạch → người duyệt&lt;br&gt;chưa phân giải → Tầng 2" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="330" y="455" width="240" height="44" as="geometry" /></mxCell><mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" edge="1" parent="1" source="lo" target="lo2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="fl" value="Gắn cờ: protocol_mismatch,&lt;br&gt;sa_mismatch, config_port_differs" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="460" width="230" height="50" as="geometry" /></mxCell><mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" edge="1" parent="1" source="pick" target="fl"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="next" value="&lt;b&gt;Sang GĐ3&lt;/b&gt;&lt;br&gt;(cạnh có traffic)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="550" width="230" height="44" as="geometry" /></mxCell><mxCell id="e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" edge="1" parent="1" source="fl" target="next"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram name="T1 GD3 Diem va trang thai" id="t3"><mxGraphModel grid="1" gridSize="10" guides="1" connect="1" arrows="1" page="1" pageScale="1" pageWidth="1200" pageHeight="800"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="in" value="&lt;b&gt;Cạnh có traffic&lt;/b&gt;&lt;br&gt;(từ GĐ2)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="230" height="50" as="geometry" /></mxCell><mxCell id="ft" value="&lt;b&gt;Tính 6 đặc trưng&lt;/b&gt; (cửa sổ 7 ngày)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="230" height="50" as="geometry" /></mxCell><mxCell id="ftl" value="recency = 1 − ngày từ lần thấy cuối / 7&lt;br&gt;log_volume = log(count+1) / log(ref+1)&lt;br&gt;distinct_days_ratio = số ngày / 7&lt;br&gt;healthcheck_ratio, monitoring_ratio&lt;br&gt;config_match_strength: 1,0 / 0,3 / 0" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=8;fontSize=10;" vertex="1" parent="1"><mxGeometry x="330" y="100" width="240" height="90" as="geometry" /></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" edge="1" parent="1" source="in" target="ft"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="" style="edgeStyle=ortho